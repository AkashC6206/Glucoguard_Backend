# =============================================================================
# GlucoGuard Backend - Git Ignore
# =============================================================================

# 1. Environment variables & API keys (CRITICAL - Never commit keys!)
.env
*.env
!.env.example

# 2. Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 3. Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# 4. Distribution, Builds & Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 5. Testing, Linting & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
htmlcov/
.mypy_cache/
.ruff_cache/

# 6. IDEs & Operating System files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 7. Logs & Temporary Debug Files
*.log
logs/
tmp/
